{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portfolio/",
      "destination": "https://drive.google.com/file/d/13HX2EGRY8lcPRXUgZrhptH91xbmZ62B3/view",
      "permanent": false
    },
    {
      "source": "/dentista/:path*",
      "destination": "/modelos/dentista/:path*",
      "permanent": true
    },
    {
      "source": "/advocacia/:path*",
      "destination": "/modelos/advocacia/:path*",
      "permanent": true
    },
    {
      "source": "/contabilidade/:path*",
      "destination": "/modelos/contabilidade/:path*",
      "permanent": true
    },
    {
      "source": "/estetica/:path*",
      "destination": "/modelos/estetica/:path*",
      "permanent": true
    },
    {
      "source": "/restaurante/:path*",
      "destination": "/modelos/restaurante/:path*",
      "permanent": true
    },
    {
      "source": "/educacao/:path*",
      "destination": "/modelos/educacao/:path*",
      "permanent": true
    }
  ]
}
