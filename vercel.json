{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portfolio/",
      "destination": "https://drive.google.com/file/d/13HX2EGRY8lcPRXUgZrhptH91xbmZ62B3/view",
      "permanent": false
    },
    {
      "source": "/:slug(dentista|advocacia|contabilidade|estetica|restaurante|educacao)",
      "destination": "/modelos/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(dentista|advocacia|contabilidade|estetica|restaurante|educacao)/:path*",
      "destination": "/modelos/:slug/:path*",
      "permanent": true
    }
  ]
}
